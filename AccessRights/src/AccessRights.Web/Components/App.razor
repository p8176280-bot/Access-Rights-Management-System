<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sarabun:wght@400;600&display=swap" />
    <link rel="stylesheet" href="app.css" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />

    <div id="blazor-error-ui" class="alert alert-danger m-0 rounded-0 fixed-bottom">
        เกิดข้อผิดพลาด กรุณา <a href="" class="reload">โหลดหน้าใหม่</a>
    </div>

    <script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    // หน้า Login เป็นหน้าแบบ Static (ต้องเขียน Cookie) ส่วนหน้าอื่นเป็น Interactive Server
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
