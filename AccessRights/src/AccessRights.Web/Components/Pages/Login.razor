@page "/login"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout LoginLayout
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>เข้าสู่ระบบ | @AppInfo.ShortName</PageTitle>

<div class="card login-card">
    <div class="card-body p-4">
        <img src="logo.svg" alt="" width="72" height="72" class="d-block mx-auto mb-2" />
        <p class="text-center text-muted small fw-semibold mb-1">@AppInfo.CompanyName</p>
        <h1 class="h4 text-center mb-1">@AppInfo.SystemName</h1>
        <p class="text-center text-muted small mb-4">@AppInfo.SystemNameEn · เข้าสู่ระบบสำหรับผู้ใช้งาน</p>

        @if (error is not null)
        {
            <div class="alert alert-danger">@error</div>
        }

        <EditForm Model="Input" method="post" OnSubmit="LoginAsync" FormName="login">
            <div class="mb-3">
                <label class="form-label" for="username">ชื่อผู้ใช้ (ภาษาอังกฤษ)</label>
                <InputText id="username" class="form-control" @bind-Value="Input!.Username" autocomplete="username" autofocus />
            </div>
            <div class="mb-4">
                <label class="form-label" for="password">รหัสผ่าน</label>
                <InputText id="password" type="password" class="form-control" @bind-Value="Input!.Password" autocomplete="current-password" />
            </div>
            <button type="submit" class="btn btn-primary w-100">เข้าสู่ระบบ</button>
        </EditForm>

        <p class="text-muted small mt-4 mb-2 text-center">ยังไม่มีบัญชี? ติดต่อผู้ดูแลระบบ (Admin) เพื่อสร้างบัญชีให้</p>
        <hr />
        <a href="admin/login" class="btn btn-outline-dark btn-sm w-100">สำหรับผู้ดูแลระบบ: เข้าสู่ระบบผู้ดูแล</a>
    </div>
</div>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm] private LoginInput? Input { get; set; }

    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    private string? error;

    protected override void OnInitialized() => Input ??= new();

    private async Task LoginAsync()
    {
        var user = await Auth.ValidateAsync(Input!.Username, Input.Password);
        if (user is null)
        {
            error = "ชื่อผู้ใช้หรือรหัสผ่านไม่ถูกต้อง หรือบัญชีถูกปิดใช้งาน";
            Input.Password = null;
            return;
        }

        await AuthCookie.SignInAsync(HttpContext, user);
        Nav.NavigateTo(AuthCookie.IsLocalUrl(ReturnUrl) ? ReturnUrl! : "/", forceLoad: true);
    }

    private sealed class LoginInput
    {
        public string? Username { get; set; }
        public string? Password { get; set; }
    }
}
