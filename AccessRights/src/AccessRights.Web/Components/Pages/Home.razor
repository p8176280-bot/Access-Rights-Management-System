@page "/"
@inherits AppPage
@inject RequestService Requests
@inject InboxService Inbox
@inject NavigationManager Nav

<PageTitle>หน้าแรก | @AppInfo.ShortName</PageTitle>

<h1 class="h4 mb-4">สวัสดี คุณ@(Actor?.FullName)</h1>

<Alerts Error="@Error" />

@if (Actor is not null && Loaded)
{
    <div class="row g-3 mb-4">
        @if (Actor.IsRequester)
        {
            <div class="col-sm-6 col-lg-3">
                <a class="card stat-card" href="requests">
                    <div class="card-body">
                        <div class="stat-value">@myPending</div>
                        <div class="text-muted">คำขอของฉันที่รอพิจารณา</div>
                    </div>
                </a>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="card stat-card">
                    <div class="card-body">
                        <div class="stat-value">@activeRights.Count</div>
                        <div class="text-muted">สิทธิที่ใช้งานอยู่</div>
                    </div>
                </div>
            </div>
        }
        @if (Actor.IsApprover || Actor.IsAdmin)
        {
            <div class="col-sm-6 col-lg-3">
                <a class="card stat-card" href="@(Actor.IsAdmin ? "admin/requests" : "reviews")">
                    <div class="card-body">
                        <div class="stat-value">@toReview</div>
                        <div class="text-muted">คำขอที่รอฉันพิจารณา</div>
                    </div>
                </a>
            </div>
        }
        <div class="col-sm-6 col-lg-3">
            <a class="card stat-card" href="notifications">
                <div class="card-body">
                    <div class="stat-value">@unread</div>
                    <div class="text-muted">แจ้งเตือนที่ยังไม่อ่าน</div>
                </div>
            </a>
        </div>
    </div>

    @if (Actor.IsRequester)
    {
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h2 class="h5 m-0">สิทธิที่ใช้งานอยู่</h2>
            <a class="btn btn-primary btn-sm" href="requests/new">+ ยื่นคำขอใหม่</a>
        </div>

        @if (activeRights.Count == 0)
        {
            <p class="text-muted">ยังไม่มีสิทธิที่ใช้งานอยู่</p>
        }
        else
        {
            <div class="card">
                <table class="table mb-0 align-middle">
                    <thead><tr><th>สิทธิ</th><th>อนุมัติเมื่อ</th><th>ใช้ได้ถึง</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var r in activeRights)
                        {
                            <tr>
                                <td>@r.Right.Name</td>
                                <td>@Fmt.Time(r.DecidedAt)</td>
                                <td>
                                    @if (r.EndDate is { } end)
                                    {
                                        var daysLeft = end.DayNumber - Today.DayNumber;
                                        <span>@Fmt.Day(end)</span>
                                        <span class="small @(daysLeft <= 7 ? "text-danger" : "text-muted")">(เหลือ @daysLeft วัน)</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">ไม่มีวันหมดอายุ</span>
                                    }
                                </td>
                                <td class="text-end"><a href="requests/@r.Id">@r.RequestNo</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
}

@code {
    private List<AccessRequest> activeRights = [];
    private int myPending;
    private int toReview;
    private int unread;

    protected override async Task LoadAsync()
    {
        // บัญชีที่เป็นผู้ดูแลระบบอย่างเดียว ไม่มีงานในส่วนผู้ใช้งาน → ไปส่วนผู้ดูแลเลย
        if (Actor!.IsAdmin && !Actor.IsRequester && !Actor.IsApprover)
        {
            Nav.NavigateTo("admin");
            return;
        }

        if (Actor.IsRequester)
        {
            activeRights = await Requests.ListMyActiveRightsAsync(Actor);
            myPending = (await Requests.ListMineAsync(Actor)).Count(r => r.Status == RequestStatus.Pending);
        }
        if (Actor.IsApprover || Actor.IsAdmin)
            toReview = (await Requests.ListPendingReviewsAsync(Actor)).Count;

        unread = await Inbox.CountUnreadAsync(Actor);
    }
}
