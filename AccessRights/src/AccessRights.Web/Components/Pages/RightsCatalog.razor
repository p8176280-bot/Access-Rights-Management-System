@page "/rights"
@inherits AppPage
@inject RightService RightSvc
@inject RequestService Requests

<PageTitle>รายการสิทธิ | @AppInfo.ShortName</PageTitle>

<h1 class="h4 mb-1">รายการสิทธิที่ขอได้</h1>
<p class="text-muted small mb-3">เลือกโปรแกรมหรือสิทธิที่ต้องการ แล้วกด "ขอสิทธินี้" เพื่อยื่นคำขอ</p>

<Alerts Error="@Error" />

@if (Loaded && Error is null)
{
    <input class="form-control mb-3" style="max-width: 360px" placeholder="ค้นหาชื่อสิทธิหรือคำอธิบาย"
           @bind="search" @bind:event="oninput" />

    @if (Filtered.Count == 0)
    {
        <p class="text-muted">ไม่พบรายการสิทธิ</p>
    }
    else
    {
        <div class="row g-3">
            @foreach (var right in Filtered)
            {
                var active = activeByRight.GetValueOrDefault(right.Id);
                var pending = pendingByRight.GetValueOrDefault(right.Id);
                <div class="col-md-6 col-xl-4">
                    <div class="card h-100 right-card @(active is not null ? "has-right" : "")">
                        <div class="card-body d-flex flex-column">
                            <h2 class="h6 mb-1">@right.Name</h2>
                            <p class="small text-muted flex-grow-1 mb-3">@(right.Description ?? "ไม่มีคำอธิบาย")</p>
                            <ul class="list-unstyled small mb-3">
                                <li>ผู้อนุมัติ: <strong>@right.Approver.FullName</strong></li>
                                <li>ขอได้นานสุด: <strong>@Fmt.MaxDays(right.MaxDurationDays)</strong></li>
                            </ul>

                            @if (active is not null)
                            {
                                <div class="alert alert-success small py-2 mb-0">
                                    คุณมีสิทธินี้แล้ว · ใช้ได้ถึง @(active.EndDate is null ? "ไม่มีวันหมดอายุ" : Fmt.Day(active.EndDate))
                                    <a href="requests/@active.Id" class="ms-1">ดูรายละเอียด</a>
                                </div>
                            }
                            else if (pending is not null)
                            {
                                <div class="alert alert-warning small py-2 mb-0">
                                    มีคำขอรอพิจารณาอยู่ <a href="requests/@pending.Id">@pending.RequestNo</a>
                                </div>
                            }
                            else if (Actor!.IsRequester)
                            {
                                <a class="btn btn-primary w-100" href="requests/new?rightId=@right.Id">ขอสิทธินี้</a>
                            }
                            else
                            {
                                <div class="small text-muted">ต้องมีบทบาท Requester จึงจะขอสิทธิได้</div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    private List<Right> rights = [];
    private Dictionary<int, AccessRequest> activeByRight = [];
    private Dictionary<int, AccessRequest> pendingByRight = [];
    private string search = "";

    private List<Right> Filtered => string.IsNullOrWhiteSpace(search)
        ? rights
        : rights.Where(r => r.Name.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase)
                            || (r.Description ?? "").Contains(search.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task LoadAsync()
    {
        rights = await RightSvc.ListActiveAsync();

        if (Actor!.IsRequester)
        {
            var mine = await Requests.ListMineAsync(Actor);
            activeByRight = mine.Where(r => r.IsActiveOn(Today))
                .GroupBy(r => r.RightId).ToDictionary(g => g.Key, g => g.First());
            pendingByRight = mine.Where(r => r.Status == RequestStatus.Pending)
                .GroupBy(r => r.RightId).ToDictionary(g => g.Key, g => g.First());
        }
    }
}
