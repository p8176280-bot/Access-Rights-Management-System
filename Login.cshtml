
@page
@model AccessRightsManagement.Pages.LoginModel
@{
    ViewData["Title"] = "เข้าสู่ระบบ";
    Layout = null;
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>เข้าสู่ระบบ | Access Rights</title>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f8eaf1;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .login-container {
            background: white;
            width: 380px;
            padding: 35px;
            border-radius: 16px;
            box-shadow: 0 5px 20px #00000012;
        }

        h2 {
            text-align: center;
            color: #773c5b;
            margin-bottom: 8px;
        }

        .subtitle {
            text-align: center;
            color: #999;
            margin-bottom: 30px;
            font-size: 13px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            color: #555;
        }

        input {
            width: 100%;
            padding: 12px;
            margin-bottom: 20px;
            border: 1px solid #ddd;
            border-radius: 8px;
            font-size: 14px;
        }

        button {
            width: 100%;
            padding: 13px;
            background: #a84f79;
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-size: 16px;
        }

        button:hover {
            background: #873d61;
        }

        .error {
            color: #d33;
            text-align: center;
            margin-bottom: 15px;
        }

        .footer {
            text-align: center;
            color: #999;
            font-size: 12px;
            margin-top: 25px;
        }
    </style>
</head>
<body>

    <div class="login-container">
        <h2>Access Rights</h2>
        <div class="subtitle">MANAGEMENT SYSTEM</div>

        <h3>เข้าสู่ระบบ</h3>

        <form method="post">
            <label>ชื่อผู้ใช้งาน</label>
            <input asp-for="Username"
                   placeholder="กรอกชื่อผู้ใช้งาน"
                   required />

            <label>รหัสผ่าน</label>
            <input asp-for="Password"
                   type="password"
                   placeholder="กรอกรหัสผ่าน"
                   required />

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="error">@Model.ErrorMessage</div>
            }

            <button type="submit">เข้าสู่ระบบ</button>
        </form>

        <div class="footer">
            สำหรับบุคลากรภายในองค์กร
        </div>
    </div>

</body>
</html>
